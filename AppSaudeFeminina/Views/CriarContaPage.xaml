<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppSaudeFeminina.CriarContaPage"
             x:Name="ThisPage"
             BackgroundColor="#FBF4EB">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Título dinâmico -->
            <Label x:Name="LabelTitulo" Text="Criar Conta"
                   FontSize="28" FontAttributes="Bold" TextColor="#C43A4A"
                   Margin="0,10,0,0" FontFamily="LeckerliOne"/>

            <!-- ── Sobre Você ──────────────────────────────────────── -->
            <Label Text="Sobre você"
                   FontSize="20" FontAttributes="Bold" TextColor="#C43A4A" Margin="0,10,0,0"/>

            <Label Text="NOME COMPLETO"
                   FontSize="12" FontAttributes="Bold" TextColor="#C56682" Margin="4,0,0,0"/>
            <Border StrokeThickness="1" Stroke="#FBD9E5" BackgroundColor="White" StrokeShape="RoundRectangle 14">
                <Entry x:Name="EntryNome" PlaceholderColor="#B0B0B0" TextColor="#3A1A1A"
                       BackgroundColor="Transparent" Margin="15,0" HeightRequest="55"/>
            </Border>

            <Label Text="E-MAIL PRINCIPAL"
                   FontSize="12" FontAttributes="Bold" TextColor="#C56682" Margin="4,0,0,0"/>
            <Border StrokeThickness="1" Stroke="#FBD9E5" BackgroundColor="White" StrokeShape="RoundRectangle 14">
                <Entry x:Name="EntryEmail" Keyboard="Email" PlaceholderColor="#B0B0B0" TextColor="#3A1A1A"
                       BackgroundColor="Transparent" Margin="15,0" HeightRequest="55"/>
            </Border>

            <!-- Senha só aparece no cadastro -->
            <VerticalStackLayout x:Name="SecaoSenha" Spacing="6">
                <Label Text="SENHA"
                       FontSize="12" FontAttributes="Bold" TextColor="#C56682" Margin="4,0,0,0"/>
                <Border StrokeThickness="1" Stroke="#FBD9E5" BackgroundColor="White" StrokeShape="RoundRectangle 14">
                    <Entry x:Name="EntryPassword" IsPassword="True" PlaceholderColor="#B0B0B0" TextColor="#3A1A1A"
                           BackgroundColor="Transparent" Margin="15,0" HeightRequest="55"/>
                </Border>
            </VerticalStackLayout>

            <Label Text="TELEFONE"
                   FontSize="12" FontAttributes="Bold" TextColor="#C56682" Margin="4,0,0,0"/>
            <Border StrokeThickness="1" Stroke="#FBD9E5" BackgroundColor="White" StrokeShape="RoundRectangle 14">
                <Entry x:Name="EntryTelefone" Keyboard="Telephone" PlaceholderColor="#B0B0B0" TextColor="#3A1A1A"
                       BackgroundColor="Transparent" Margin="15,0" HeightRequest="55"/>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="DATA NASCIMENTO"
                           FontSize="12" FontAttributes="Bold" TextColor="#C56682" Margin="4,0,0,5"/>
                    <Border StrokeThickness="1" Stroke="#FBD9E5" BackgroundColor="White" StrokeShape="RoundRectangle 14">
                        <DatePicker x:Name="DatePickerNascimento" Format="dd/MM/yyyy" TextColor="#3A1A1A"
                                    BackgroundColor="Transparent" Margin="15,0" HeightRequest="55"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="CIDADE"
                           FontSize="12" FontAttributes="Bold" TextColor="#C56682" Margin="4,0,0,5"/>
                    <Border StrokeThickness="1" Stroke="#FBD9E5" BackgroundColor="White" StrokeShape="RoundRectangle 14">
                        <Entry x:Name="EntryCidade" PlaceholderColor="#B0B0B0" TextColor="#3A1A1A"
                               BackgroundColor="Transparent" Margin="15,0" HeightRequest="55"/>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="ALTURA (CM)"
                           FontSize="12" FontAttributes="Bold" TextColor="#C56682" Margin="4,0,0,5"/>
                    <Border StrokeThickness="1" Stroke="#FBD9E5" BackgroundColor="White" StrokeShape="RoundRectangle 14">
                        <Entry x:Name="EntryAltura" Keyboard="Numeric" PlaceholderColor="#B0B0B0" TextColor="#3A1A1A"
                               BackgroundColor="Transparent" Margin="15,0" HeightRequest="55"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="PESO (KG)"
                           FontSize="12" FontAttributes="Bold" TextColor="#C56682" Margin="4,0,0,5"/>
                    <Border StrokeThickness="1" Stroke="#FBD9E5" BackgroundColor="White" StrokeShape="RoundRectangle 14">
                        <Entry x:Name="EntryPeso" Keyboard="Numeric" PlaceholderColor="#B0B0B0" TextColor="#3A1A1A"
                               BackgroundColor="Transparent" Margin="15,0" HeightRequest="55"/>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- Tipo Sanguíneo + Fase da Vida -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="TIPO SANGUÍNEO"
                           FontSize="12" FontAttributes="Bold" TextColor="#C56682" Margin="4,0,0,5"/>
                    <Border StrokeThickness="1" Stroke="#FBD9E5" BackgroundColor="White"
                            StrokeShape="RoundRectangle 14" HeightRequest="55">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTipoSanguineoTapped"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" Padding="15,0">
                            <Label x:Name="LblTipoSanguineo" Text="Selecionar"
                                   VerticalOptions="Center" TextColor="#C43A4A" FontAttributes="Bold"/>
                            <Label Grid.Column="1" Text="▼" TextColor="#C43A4A" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                    <Border x:Name="BorderTipoSanguineo" IsVisible="False"
                            StrokeThickness="1" Stroke="#FBD9E5" BackgroundColor="White"
                            Margin="0,2,0,0" StrokeShape="RoundRectangle 14" ZIndex="999">
                        <CollectionView x:Name="CvTipoSanguineo" SelectionMode="Single"
                                        SelectionChanged="OnTipoSanguineoSelected">
                            <CollectionView.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>A+</x:String><x:String>A-</x:String>
                                    <x:String>B+</x:String><x:String>B-</x:String>
                                    <x:String>AB+</x:String><x:String>AB-</x:String>
                                    <x:String>O+</x:String><x:String>O-</x:String>
                                </x:Array>
                            </CollectionView.ItemsSource>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="15,10">
                                        <Label Text="{Binding .}" TextColor="#C43A4A" FontSize="14"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1">
                    <Label Text="FASE DA VIDA"
                           FontSize="12" FontAttributes="Bold" TextColor="#C56682" Margin="4,0,0,5"/>
                    <Border StrokeThickness="1" Stroke="#FBD9E5" BackgroundColor="White"
                            StrokeShape="RoundRectangle 14" HeightRequest="55">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFaseVidaTapped"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" Padding="15,0">
                            <Label x:Name="LblFaseVida" Text="Selecionar"
                                   VerticalOptions="Center" TextColor="#C43A4A" FontAttributes="Bold" FontSize="11"/>
                            <Label Grid.Column="1" Text="▼" TextColor="#C43A4A" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                    <Border x:Name="BorderFaseVida" IsVisible="False"
                            StrokeThickness="1" Stroke="#FBD9E5" BackgroundColor="White"
                            Margin="0,2,0,0" StrokeShape="RoundRectangle 14" ZIndex="999">
                        <CollectionView x:Name="CvFaseVida" SelectionMode="Single"
                                        SelectionChanged="OnFaseVidaSelected">
                            <CollectionView.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Adolescência</x:String>
                                    <x:String>Fase Adulta</x:String>
                                    <x:String>Tentante</x:String>
                                    <x:String>Gestação e Pós-parto</x:String>
                                    <x:String>Climatério</x:String>
                                    <x:String>Senescência</x:String>
                                </x:Array>
                            </CollectionView.ItemsSource>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="15,10">
                                        <Label Text="{Binding .}" TextColor="#C43A4A" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- ── Saúde Menstrual ─────────────────────────────────── -->
            <Label Text="Saúde Menstrual"
                   FontSize="20" FontAttributes="Bold" TextColor="#C43A4A" Margin="0,10,0,0"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="DURAÇÃO DO CICLO (DIAS)"
                           FontSize="12" FontAttributes="Bold" TextColor="#C56682" Margin="4,0,0,5"/>
                    <Border StrokeThickness="1" Stroke="#FBD9E5" BackgroundColor="White" StrokeShape="RoundRectangle 14">
                        <Entry x:Name="EntryDuracaoCiclo" Keyboard="Numeric" Placeholder="28"
                               PlaceholderColor="#B0B0B0" TextColor="#3A1A1A"
                               BackgroundColor="Transparent" Margin="15,0" HeightRequest="55"/>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="DURAÇÃO DO FLUXO (DIAS)"
                           FontSize="12" FontAttributes="Bold" TextColor="#C56682" Margin="4,0,0,5"/>
                    <Border StrokeThickness="1" Stroke="#FBD9E5" BackgroundColor="White" StrokeShape="RoundRectangle 14">
                        <Entry x:Name="EntryDuracaoFluxo" Keyboard="Numeric" Placeholder="5"
                               PlaceholderColor="#B0B0B0" TextColor="#3A1A1A"
                               BackgroundColor="Transparent" Margin="15,0" HeightRequest="55"/>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Label Text="ÚLTIMA MENSTRUAÇÃO"
                   FontSize="12" FontAttributes="Bold" TextColor="#C56682" Margin="4,0,0,0"/>
            <Border StrokeThickness="1" Stroke="#FBD9E5" BackgroundColor="White" StrokeShape="RoundRectangle 14">
                <DatePicker x:Name="DatePickerUltimaMenstruacao" Format="dd/MM/yyyy" TextColor="#3A1A1A"
                            BackgroundColor="Transparent" Margin="15,0" HeightRequest="55"/>
            </Border>

            <VerticalStackLayout Spacing="5">
                <Label Text="CICLO REGULAR?"
                       FontSize="12" FontAttributes="Bold" TextColor="#C56682" Margin="4,0,0,0"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button x:Name="BtnSim" Grid.Column="0" Text="Sim"
                            BackgroundColor="White" TextColor="#3A1A1A"
                            BorderColor="#FBD9E5" BorderWidth="1" CornerRadius="15" HeightRequest="50"
                            Clicked="OnCicloSelecionado"/>
                    <Button x:Name="BtnIrregular" Grid.Column="1" Text="Irregular"
                            BackgroundColor="#C43A4A" TextColor="White"
                            BorderWidth="0" CornerRadius="15" HeightRequest="50"
                            Clicked="OnCicloSelecionado"/>
                </Grid>
            </VerticalStackLayout>

            <!-- ── Contracepção ────────────────────────────────────── -->
            <Label Text="Contracepção"
                   FontSize="20" FontAttributes="Bold" TextColor="#C43A4A" Margin="0,10,0,0"/>

            <Label Text="USA ANTICONCEPCIONAL?"
                   FontSize="12" FontAttributes="Bold" TextColor="#C56682" Margin="4,0,0,0"/>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button x:Name="BtnContSim" Grid.Column="0" Text="Sim"
                        BackgroundColor="White" TextColor="#3A1A1A"
                        BorderColor="#FBD9E5" BorderWidth="1" CornerRadius="15" HeightRequest="50"
                        Clicked="OnAntiSelecionado"/>
                <Button x:Name="BtnContNao" Grid.Column="1" Text="Não"
                        BackgroundColor="#C43A4A" TextColor="White"
                        BorderWidth="0" CornerRadius="15" HeightRequest="50"
                        Clicked="OnAntiSelecionado"/>
            </Grid>

            <Label Text="DESEJA ENGRAVIDAR?"
                   FontSize="12" FontAttributes="Bold" TextColor="#C56682" Margin="4,10,0,0"/>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Button x:Name="BtnEngSim" Grid.Column="0" Text="Sim"
                        BackgroundColor="White" TextColor="#3A1A1A"
                        BorderColor="#FBD9E5" BorderWidth="1" CornerRadius="15" HeightRequest="50"
                        Clicked="OnEngravidarSelecionado"/>
                <Button x:Name="BtnEngNao" Grid.Column="1" Text="Não"
                        BackgroundColor="#C43A4A" TextColor="White"
                        BorderWidth="0" CornerRadius="15" HeightRequest="50"
                        Clicked="OnEngravidarSelecionado"/>
                <Button x:Name="BtnEngTalvez" Grid.Column="2" Text="Talvez"
                        BackgroundColor="White" TextColor="#3A1A1A"
                        BorderColor="#FBD9E5" BorderWidth="1" CornerRadius="15" HeightRequest="50"
                        Clicked="OnEngravidarSelecionado"/>
            </Grid>

            <!-- ── Objetivo ────────────────────────────────────────── -->
            <Label Text="Objetivo"
                   FontSize="20" FontAttributes="Bold" TextColor="#C43A4A" Margin="0,10,0,0"/>

            <Border StrokeThickness="1" Stroke="#FBD9E5" BackgroundColor="White"
                    StrokeShape="RoundRectangle 14" HeightRequest="55">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDropdownTapped"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" Padding="15,0">
                    <Label x:Name="LblObjetivoSelecionado" Text="Monitorar ciclo"
                           VerticalOptions="Center" TextColor="#C43A4A" FontAttributes="Bold"/>
                    <Label Grid.Column="1" Text="▼" TextColor="#C43A4A" VerticalOptions="Center"/>
                </Grid>
            </Border>
            <Border x:Name="BorderDropdown" IsVisible="False"
                    StrokeThickness="1" Stroke="#FBD9E5" BackgroundColor="White"
                    Margin="0,2,0,0" StrokeShape="RoundRectangle 14" ZIndex="1000">
                <CollectionView x:Name="CvObjetivos" SelectionMode="Single" SelectionChanged="OnObjetivoSelected">
                    <CollectionView.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Monitorar ciclo</x:String>
                            <x:String>Engravidar</x:String>
                            <x:String>Evitar gravidez</x:String>
                            <x:String>Acompanhar sintomas</x:String>
                        </x:Array>
                    </CollectionView.ItemsSource>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="15,12">
                                <Label Text="{Binding .}" TextColor="#C43A4A" FontSize="15"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <!-- LGPD -->
            <Border BackgroundColor="#FBD9E5" StrokeThickness="0" Padding="20,15"
                    StrokeShape="RoundRectangle 40" Margin="0,10,0,0">
                <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                    <Label Text="🛡️" FontSize="20" TextColor="#C43A4A" VerticalOptions="Center"/>
                    <Label Text="SEUS DADOS ESTÃO SEGUROS CONFORME A LGPD."
                           FontSize="11" FontAttributes="Bold" TextColor="#C43A4A" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Botão -->
            <Border x:Name="BtnConcluir" HeightRequest="60" HorizontalOptions="FillAndExpand"
                    Margin="0,10,0,30" StrokeThickness="0" StrokeShape="RoundRectangle 30">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#C43A4A" Offset="0.0"/>
                        <GradientStop Color="#C56682" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,5" Radius="10" Opacity="0.2"/>
                </Border.Shadow>
                <Label x:Name="LabelBotao" Text="CRIAR CONTA"
                       TextColor="White" FontAttributes="Bold" FontSize="14"
                       CharacterSpacing="1" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnConcluirClicked"/>
                </Border.GestureRecognizers>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
